generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id String @id @default("default")

  siteName        String  @default("thatmanfrancis")
  tagline         String?
  metaDescription String? @db.Text

  heroEyebrow  String?
  heroTitle    String?
  heroLede     String? @db.Text
  heroCtaLabel String?
  heroRole     String?

  aboutTitle    String?
  aboutBody     String? @db.Text
  aboutImageUrl String?
  availability  String?
  resumeUrl     String?
  skills        String[] @default([])
  stackTitle    String?
  disciplinesTitle String?
  disciplinesLede  String? @db.Text
  disciplines   Json     @default("[]")
  processTitle  String?
  processCta    String?
  processSteps  Json     @default("[]")

  experienceTitle String?
  experienceLede  String? @db.Text
  experience      Json     @default("[]")

  faqTitle String?
  faqLede  String? @db.Text
  faq      Json     @default("[]")

  contactTitle    String?
  contactLede     String? @db.Text
  contactEmail    String?
  contactPhone    String?
  contactLocation String?

  socialX             String?
  socialGithub        String?
  socialLinkedin      String?
  socialInstagram     String?
  socialYoutube       String?
  socialFacebook      String?
  socialDiscord       String?
  socialBluesky       String?
  socialMastodon      String?
  socialDevto         String?
  socialHashnode      String?
  socialCodepen       String?
  socialStackoverflow String?
  socialDribbble      String?
  socialWebsite       String?

  footerText String?

  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NewsletterCampaign {
  id             String    @id @default(cuid())
  subject        String
  previewText    String?
  body           String    @db.Text
  ctaLabel       String?
  ctaUrl         String?
  status         String    @default("draft")
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  lastError      String?   @db.Text
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  description String   @db.Text
  coverUrl    String?
  projectUrl  String?
  repoUrl     String?
  role        String?
  year        String?
  problem     String?  @db.Text
  outcome     String?  @db.Text
  kind        String?
  endpoint    String?
  apiSample   String?  @db.Text
  stack       String[] @default([])
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured, sortOrder])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  coverUrl    String?
  gallery     String[]  @default([])
  published   Boolean   @default(false)
  publishedAt DateTime?
  viewCount   Int       @default(0)
  xPostUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}
